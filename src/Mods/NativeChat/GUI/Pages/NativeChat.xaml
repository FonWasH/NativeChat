<ls:UIWidget x:Name="NativeChat"
             Visibility="Collapsed"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ls="clr-namespace:ls;assembly=Code"
             xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:noesis="clr-namespace:NoesisGUIExtensions;assembly=Noesis.GUI.Extensions"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d">

    <ls:UIWidget.Resources>
        <BitmapImage x:Key="PanelBg"
                     UriSource="pack://application:,,,/Core;component/Assets/CharacterPanel/genericFaded_bg.png"/>

        <SolidColorBrush x:Key="Gold" Color="#FFE0C083"/>
        <SolidColorBrush x:Key="TipText" Color="#FFAF8768"/>
        <DataTemplate x:Key="TipPlainTemplate">
            <TextBlock Text="{Binding}" Foreground="{StaticResource TipText}"/>
        </DataTemplate>
        <DataTemplate x:Key="TipKeyTemplate">
            <TextBlock><Run Text="{Binding TipKey}" Foreground="{StaticResource TipText}"/><Run Text="{Binding TipKeyValue}"/></TextBlock>
        </DataTemplate>
        <DataTemplate x:Key="TipOverheadTemplate">
            <TextBlock><Run Text="{Binding TipOverhead}" Foreground="{StaticResource TipText}"/><Run Text="{Binding TipOverheadValue}"/></TextBlock>
        </DataTemplate>
        <DataTemplate x:Key="TipAutoHideTemplate">
            <TextBlock><Run Text="{Binding TipAutoHide}" Foreground="{StaticResource TipText}"/><Run Text="{Binding TipAutoHideValue}"/></TextBlock>
        </DataTemplate>
        <SolidColorBrush x:Key="Gray" Color="#FF8C8C8C"/>
        <SolidColorBrush x:Key="Text" Color="#FFF0E6D2"/>
        <SolidColorBrush x:Key="ButtonBg" Color="#CC140F0A"/>
        <SolidColorBrush x:Key="ButtonBgPressed" Color="#CC2A2016"/>
        <SolidColorBrush x:Key="ButtonBorder" Color="#FF7A6440"/>
        <SolidColorBrush x:Key="ChoiceOnBg" Color="#CC5A4326"/>
        <SolidColorBrush x:Key="BarBg" Color="#E6100C0A"/>
        <SolidColorBrush x:Key="HexText" Color="#FFE8D2B0"/>

        <Style x:Key="ChatButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource Gold}"/>
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="MinHeight" Value="40"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{StaticResource ButtonBg}"
                                BorderBrush="{StaticResource ButtonBorder}"
                                BorderThickness="2" CornerRadius="4" Padding="14,2">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="BorderBrush" Value="{StaticResource Gold}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource ButtonBgPressed}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ChoiceButton" TargetType="Button" BasedOn="{StaticResource ChatButton}">
            <Setter Property="Margin" Value="4"/>
            <Setter Property="MinHeight" Value="48"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{StaticResource ButtonBg}"
                                BorderBrush="{StaticResource ButtonBorder}"
                                BorderThickness="2" CornerRadius="4" Padding="10,2">
                            <Viewbox StretchDirection="DownOnly" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <ContentPresenter/>
                            </Viewbox>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Tag" Value="on">
                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource ChoiceOnBg}"/>
                                <Setter TargetName="Bg" Property="BorderBrush" Value="{StaticResource Gold}"/>
                                <Setter Property="Foreground" Value="{StaticResource Text}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="BorderBrush" Value="{StaticResource Gold}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource ButtonBgPressed}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>


        <Style x:Key="HudToggle" TargetType="Button">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="1,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Width="44" Height="62" Background="Transparent">
                            <Image x:Name="btn" Source="pack://application:,,,/Core;component/Assets/Buttons/btn_hudNav_d.png" Stretch="Uniform"/>
                            <Viewbox Width="24" Height="24" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <ContentPresenter/>
                            </Viewbox>
                            <Path x:Name="slash" Data="M 13,21 L 31,41" Stroke="{StaticResource Gold}" StrokeThickness="2.5" Visibility="Collapsed"
                                  HorizontalAlignment="Left" VerticalAlignment="Top"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Tag" Value="slash">
                                <Setter TargetName="slash" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btn" Property="Source" Value="pack://application:,,,/Core;component/Assets/Buttons/btn_hudNav_h.png"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="btn" Property="Source" Value="pack://application:,,,/Core;component/Assets/Buttons/btn_hudNav_p.png"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <LinearGradientBrush x:Key="InputBorderBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#FF7A674E" Offset="0"/>
            <GradientStop Color="#FF6E5A48" Offset="0.5"/>
            <GradientStop Color="#FF875F3A" Offset="1"/>
        </LinearGradientBrush>
        <Style x:Key="NC.InputBox" TargetType="ls:LSTextBox" BasedOn="{StaticResource DefaultInputBox}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="CaretBrush" Value="{StaticResource Gold}"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ls:LSTextBox">
                        <Border Background="Transparent" BorderBrush="{StaticResource InputBorderBrush}" BorderThickness="2" CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" Template="{DynamicResource NC.ScrollViewer}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          Focusable="False" HorizontalScrollBarVisibility="Disabled"
                                          VerticalScrollBarVisibility="{TemplateBinding ScrollViewer.VerticalScrollBarVisibility}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BarValue" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Gold}"/>
            <Setter Property="FontSize" Value="30"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="MinWidth" Value="52"/>
            <Setter Property="Margin" Value="2,0"/>
        </Style>


        <Style x:Key="PillButton" TargetType="Button">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{StaticResource Gold}"/>
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ls:LSNineSliceImage x:Name="bg" ImageSource="pack://application:,,,/Core;component/Assets/BottomBar/btn_pil_d.png" Slices="36" Padding="10">
                            <Grid Height="60">
                                <Viewbox Margin="18,0" StretchDirection="DownOnly" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <ContentPresenter/>
                                </Viewbox>
                            </Grid>
                        </ls:LSNineSliceImage>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Tag" Value="on">
                                <Setter TargetName="bg" Property="ImageSource" Value="pack://application:,,,/Core;component/Assets/BottomBar/btn_pil_p.png"/>
                                <Setter Property="Foreground" Value="{StaticResource Text}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="ImageSource" Value="pack://application:,,,/Core;component/Assets/BottomBar/btn_pil_h.png"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bg" Property="ImageSource" Value="pack://application:,,,/Core;component/Assets/BottomBar/btn_pil_p.png"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <ImageSource x:Key="AbilityHexImage">pack://application:,,,/Core;component/Assets/CharacterPanel/mainStats_ability_single.png</ImageSource>
        <Style x:Key="AbilityHexButton" TargetType="Button">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{StaticResource HexText}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="Transparent">
                            <Image x:Name="hex" Source="{StaticResource AbilityHexImage}" Stretch="Uniform" Margin="6,4" Opacity="0.8"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="hex" Property="Opacity" Value="1"/>
                                <Setter Property="Foreground" Value="{StaticResource Gold}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="hex" Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>



        <ControlTemplate x:Key="GoldSeparator">
            <Grid Height="16">
                <Rectangle Height="2" VerticalAlignment="Center">
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#00E0C083" Offset="0"/>
                            <GradientStop Color="#FFE0C083" Offset="0.5"/>
                            <GradientStop Color="#00E0C083" Offset="1"/>
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>
                <Rectangle Width="10" Height="10" Fill="#FF1A1410" Stroke="#FFE0C083" StrokeThickness="2"
                           HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                    <Rectangle.RenderTransform><RotateTransform Angle="45"/></Rectangle.RenderTransform>
                </Rectangle>
            </Grid>
        </ControlTemplate>

        <ControlTemplate x:Key="NC.TabButton" TargetType="{x:Type ls:LSButton}">
            <ls:LSNineSliceImage x:Name="bg" ImageSource="{DynamicResource TabBg_d}" Slices="36" Padding="36,0" MinHeight="78" MinWidth="{TemplateBinding MinWidth}">
                <TextBlock x:Name="txt" Text="{Binding Content, RelativeSource={RelativeSource Mode=TemplatedParent}}" VerticalAlignment="Center" HorizontalAlignment="Stretch" TextAlignment="Center" TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource LS_specialTxtColor}" FontSize="{DynamicResource SmallFontSize}" Style="{DynamicResource BtnTextGlow}"/>
            </ls:LSNineSliceImage>
            <ControlTemplate.Triggers>
                <Trigger Property="Tag" Value="open">
                    <Setter Property="ImageSource" TargetName="bg" Value="{DynamicResource TabBg_h}"/>
                    <Setter Property="Foreground" TargetName="txt" Value="{DynamicResource LS_tint100}"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="ImageSource" TargetName="bg" Value="{DynamicResource TabBg_h}"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="ImageSource" TargetName="bg" Value="{DynamicResource TabBg_p}"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="ImageSource" TargetName="bg" Value="{DynamicResource TabBg_disabled}"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <ControlTemplate x:Key="NC.TabButton_Active" TargetType="{x:Type ls:LSButton}">
            <Grid>
                <ls:LSNineSliceImage x:Name="bg" ImageSource="{DynamicResource TabBg_active_d}" Slices="36" Padding="36,0" MinHeight="78" MinWidth="{TemplateBinding MinWidth}">
                    <TextBlock Text="{Binding Content, RelativeSource={RelativeSource Mode=TemplatedParent}}" VerticalAlignment="Center" HorizontalAlignment="Stretch" TextAlignment="Center" TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource LS_tint100}" FontSize="{DynamicResource SmallFontSize}" Style="{DynamicResource BtnTextGlow}"/>
                </ls:LSNineSliceImage>
                <ls:LSNineSliceImage HorizontalAlignment="Center" VerticalAlignment="Top" ImageSource="{DynamicResource BtnActiveMod}" Slices="12, 0" Width="64" Height="26" Margin="0,-12,0,0">
                    <Image Source="{DynamicResource ActiveModArrow}" Stretch="UniformToFill" VerticalAlignment="Center"/>
                </ls:LSNineSliceImage>
            </Grid>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="ImageSource" TargetName="bg" Value="{DynamicResource TabBg_active_h}"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="ImageSource" TargetName="bg" Value="{DynamicResource TabBg_active_p}"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="ImageSource" TargetName="bg" Value="{DynamicResource TabBg_active_disabled}"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <Style x:Key="ChatTab" TargetType="ls:LSButton">
            <Setter Property="Template" Value="{StaticResource NC.TabButton}"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="MinWidth" Value="200"/>
        </Style>

        <ControlTemplate x:Key="NC.ScrollViewer" TargetType="{x:Type ScrollViewer}">
            <DockPanel Background="{TemplateBinding Background}">
                <Border x:Name="PART_VerticalScrollBarHolder" DockPanel.Dock="Right" Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}">
                    <ScrollBar x:Name="PART_VerticalScrollBar" Value="{TemplateBinding VerticalOffset}" Maximum="{TemplateBinding ScrollableHeight}"
                               ViewportSize="{TemplateBinding ViewportHeight}" Margin="6,8,0,8" Style="{StaticResource GoldScrollBar}"/>
                </Border>
                <Border Margin="0" HorizontalAlignment="Stretch">
                    <ScrollContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                                            ContentTemplateSelector="{TemplateBinding ContentTemplateSelector}"
                                            CanContentScroll="{TemplateBinding CanContentScroll}" Margin="{TemplateBinding Padding}"/>
                </Border>
            </DockPanel>
            <ControlTemplate.Triggers>
                <DataTrigger Value="True">
                    <DataTrigger.Binding>
                        <MultiBinding Converter="{StaticResource GreaterOrEqualThanMultiConverter}">
                            <Binding RelativeSource="{RelativeSource Self}" Path="ScrollableHeight"/>
                            <Binding RelativeSource="{RelativeSource Self}" Path="ViewportHeight" Converter="{StaticResource MultiplierConverter}" ConverterParameter="5"/>
                        </MultiBinding>
                    </DataTrigger.Binding>
                    <Setter TargetName="PART_VerticalScrollBar" Property="ViewportSize" Value="NaN"/>
                </DataTrigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <Style x:Key="NC.JumpToLatest" TargetType="ls:LSToggleButton">
            <Setter Property="IsChecked" Value="True"/>
            <Setter Property="Visibility" Value="Hidden"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="VerticalAlignment" Value="Bottom"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="Margin" Value="0,0,30,0"/>
            <Setter Property="Panel.ZIndex" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ls:LSToggleButton}">
                        <ls:LSNineSliceImage x:Name="bg" ImageSource="pack://application:,,,/Core;component/Assets/BottomBar/btn_pil_d.png" Slices="36" Padding="10">
                            <Grid Margin="10,0" Height="60">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="40"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding Source='h6987400dg0477g4d9aga765g2b96f9ac6c0e', Converter={StaticResource TranslatedStringConverter}}"
                                           Foreground="{StaticResource LS_specialTxtColor}" FontSize="{StaticResource ScaledSmallFontSize}"
                                           VerticalAlignment="Center" TextAlignment="Right" Margin="12,0,-6,0"/>
                                <Image x:Name="Icon" Grid.Column="1" Height="40" Width="40" Margin="-14" Stretch="Uniform"
                                       Source="pack://application:,,,/Core;component/Assets/Buttons/ico_superScroll_d.png"
                                       VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            </Grid>
                        </ls:LSNineSliceImage>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="ImageSource" TargetName="bg" Value="pack://application:,,,/Core;component/Assets/BottomBar/btn_pil_h.png"/>
                                <Setter Property="Source" TargetName="Icon" Value="pack://application:,,,/Core;component/Assets/Buttons/ico_superScroll_h.png"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="ImageSource" TargetName="bg" Value="pack://application:,,,/Core;component/Assets/BottomBar/btn_pil_p.png"/>
                                <Setter Property="Source" TargetName="Icon" Value="pack://application:,,,/Core;component/Assets/Buttons/ico_superScroll_p.png"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tag, ElementName=ScrollHost}" Value="False">
                    <Setter Property="IsChecked" Value="False"/>
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CombatLog.Entry.Text" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource CombatLog.DefaultTextColor}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Style.Triggers>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding TooltipEntries.Count, Converter={StaticResource GreaterThanConverter}, ConverterParameter=0}" Value="True"/>
                        <Condition Binding="{Binding Path=IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True"/>
                    </MultiDataTrigger.Conditions>
                    <MultiDataTrigger.Setters>
                        <Setter Property="TextDecorations" Value="Underline"/>
                    </MultiDataTrigger.Setters>
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>
    </ls:UIWidget.Resources>

    <Canvas x:Name="Root" Visibility="{Binding RootVisibility, FallbackValue=Collapsed}">

        <Border x:Name="FocusSink" Focusable="True" Width="1" Height="1" Canvas.Left="0" Canvas.Top="0" Background="Transparent"/>

        <ls:LSNineSliceImage x:Name="PanelRoot"
                             Canvas.Left="{Binding PanelX}" Canvas.Top="{Binding PanelY}"
                             Width="{Binding PanelW}" Height="{Binding PanelH}"
                             Opacity="{Binding PanelOpacity}"
                             ImageSource="{StaticResource PanelBg}"
                             Slices="52"
                             Padding="34,34,34,34">

            <Grid Background="Transparent">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="1" Visibility="{Binding ChatContentVisibility}">
                    <ls:LSScrollViewer x:Name="ScrollHost" Template="{StaticResource NC.ScrollViewer}" Focusable="False"
                                       HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"
                                       ls:AutoScrollProperties.VerticalAutoScroll="{Binding IsChecked, ElementName=ChatJumpToLatest}">
                        <ls:LSScrollViewer.Tag>
                            <MultiBinding Converter="{StaticResource EqualConverter}">
                                <Binding Path="ScrollableHeight" ElementName="ScrollHost"/>
                                <Binding Path="VerticalOffset" ElementName="ScrollHost"/>
                            </MultiBinding>
                        </ls:LSScrollViewer.Tag>
                        <ItemsControl ItemsSource="{Binding Messages}" Margin="6,4,10,4" FontSize="{Binding ChatFontSize}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <TextBlock Visibility="{Binding HeaderVisibility}" Margin="0,10,0,2" TextWrapping="Wrap">
                                            <Run Text="{Binding HeaderName, Mode=OneWay}" Foreground="{StaticResource Gold}"/>
                                        </TextBlock>
                                        <TextBlock Margin="0,1,0,1" TextWrapping="Wrap"
                                                   Foreground="{StaticResource Text}"
                                                   ls:TextBlockFormatter.SourceText="{Binding Rich}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ls:LSScrollViewer>

                    <ls:LSToggleButton x:Name="ChatJumpToLatest" Style="{StaticResource NC.JumpToLatest}"/>
                </Grid>

                <Grid x:Name="LogRoot" Grid.Row="1" Grid.RowSpan="3" Visibility="{Binding DataContext.LogContentVisibility, ElementName=PanelRoot}"
                      ls:TooltipExtender.Owner="{Binding CurrentPlayer.SelectedCharacter}">
                    <ListBox ItemsSource="{Binding Data.CombatLog.EntryGroups}"
                             FontSize="{Binding DataContext.ChatFontSize, ElementName=PanelRoot}"
                             VirtualizingPanel.VirtualizationMode="Recycling" VirtualizingPanel.ScrollUnit="Pixel"
                             Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Hidden" ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.Template>
                            <ControlTemplate TargetType="ListBox">
                                <Grid>
                                    <ls:LSScrollViewer x:Name="ScrollHost" Template="{StaticResource NC.ScrollViewer}" Focusable="False"
                                                       Background="{TemplateBinding Background}"
                                                       ls:AutoScrollProperties.VerticalAutoScroll="{Binding IsChecked, ElementName=LogJumpToLatest}">
                                        <ls:LSScrollViewer.Tag>
                                            <MultiBinding Converter="{StaticResource EqualConverter}">
                                                <Binding Path="ScrollableHeight" ElementName="ScrollHost"/>
                                                <Binding Path="VerticalOffset" ElementName="ScrollHost"/>
                                            </MultiBinding>
                                        </ls:LSScrollViewer.Tag>
                                        <ItemsPresenter/>
                                    </ls:LSScrollViewer>
                                    <ls:LSToggleButton x:Name="LogJumpToLatest" Style="{StaticResource NC.JumpToLatest}"/>
                                </Grid>
                            </ControlTemplate>
                        </ListBox.Template>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="MaxWidth" Value="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType={x:Type ItemsPresenter}}}"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <ControlTemplate.Resources>
                                                <Style BasedOn="{StaticResource CombatLog.GeneratedRunWithTooltip}" TargetType="ls:LSRun"/>
                                            </ControlTemplate.Resources>
                                            <ContentPresenter x:Name="EntryPresenter" Content="{Binding Entries[0]}"
                                                              ToolTipService.InitialShowDelay="{StaticResource ToolTipInitialShowDelay}"
                                                              ToolTipService.Placement="Top" ToolTipService.VerticalOffset="-5" ToolTipService.HorizontalOffset="-14"
                                                              Margin="60,0,0,0">
                                                <ContentPresenter.ToolTip>
                                                    <ls:LSTooltip CanBePinned="False" Content="{Binding Path=DataContext, ElementName=EntryPresenter}"
                                                                  ContentTemplate="{DynamicResource CombatLog.Tooltip}"
                                                                  PlayerId="{Binding ElementName=LogRoot, Path=DataContext.CurrentPlayer.PlayerId}"
                                                                  IsHitTestVisible="False" Placement="Top"/>
                                                </ContentPresenter.ToolTip>
                                                <ContentPresenter.Resources>
                                                    <Style x:Key="TextStyle" TargetType="TextBlock" BasedOn="{StaticResource CombatLog.Entry.Text}"/>
                                                </ContentPresenter.Resources>
                                            </ContentPresenter>
                                            <ControlTemplate.Triggers>
                                                <DataTrigger Binding="{Binding ChildDepth}" Value="0">
                                                    <Setter TargetName="EntryPresenter" Property="Margin" Value="0"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding TooltipEntries.Count}" Value="0">
                                                    <Setter TargetName="EntryPresenter" Property="ToolTipService.IsEnabled" Value="False"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding CtxTransText, Converter={StaticResource NullToBoolFalseConverter}, ConverterParameter='EmptyString'}" Value="True">
                                                    <Setter TargetName="EntryPresenter" Property="Content" Value="{Binding .}"/>
                                                    <Setter TargetName="EntryPresenter" Property="ContentTemplate" Value="{StaticResource CombatLogGenericTemplate}"/>
                                                </DataTrigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>
                </Grid>

                <TextBlock Grid.Row="2" Text="{Binding TypingText}" Foreground="{StaticResource Gray}"
                           FontSize="{Binding ChatFontSize}" FontStyle="Italic" MinHeight="34" Margin="2,6,0,4"
                           TextTrimming="CharacterEllipsis" Visibility="{Binding ChatContentVisibility}"/>

                <Grid Grid.Row="3" Visibility="{Binding ChatContentVisibility}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <ls:LSTextBox x:Name="ChatInput" Grid.Column="0" Margin="0"
                                  Text="{Binding InputText, Mode=TwoWay}"
                                  TextImmediateSourceUpdate="True"
                                  PlayerId="{Binding (ls:UIWidget.PlayerId), ElementName=NativeChat}"
                                  Style="{StaticResource NC.InputBox}"
                                  MaxLength="2000"
                                  FontSize="{Binding ChatFontSize}" MinHeight="52" MaxHeight="{Binding InputMaxH}"
                                  AcceptsReturn="True" TextWrapping="Wrap"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                                  VerticalContentAlignment="Center"
                                  HorizontalContentAlignment="Left" TextAlignment="Left"
                                  UseLayoutRounding="True">
                        <ls:LSTextBox.InputBindings>
                            <KeyBinding Key="Return" Command="{Binding SendCommand}"/>
                        </ls:LSTextBox.InputBindings>
                        <b:Interaction.Triggers>
                            <b:DataTrigger Binding="{Binding FocusInput}" Value="True">
                                <noesis:SetFocusAction/>
                            </b:DataTrigger>
                            <b:DataTrigger Binding="{Binding ReleaseFocus}" Value="True">
                                <noesis:SetFocusAction TargetName="FocusSink"/>
                            </b:DataTrigger>
                        </b:Interaction.Triggers>
                    </ls:LSTextBox>

                    <TextBlock Grid.Column="0" Margin="20,0,16,0" VerticalAlignment="Center"
                               Text="{Binding PlaceholderText}" Visibility="{Binding PlaceholderVisibility}"
                               Foreground="{StaticResource Gray}" FontSize="{Binding ChatFontSize}" FontStyle="Italic"
                               IsHitTestVisible="False" TextTrimming="CharacterEllipsis"/>

                    <ls:LSButton Grid.Column="1" Style="{StaticResource PillButton}" Margin="10,0,0,0" MinWidth="130"
                            Content="{Binding EditLabel}" Command="{Binding EditCommand}">
                    </ls:LSButton>
                </Grid>

                <Border x:Name="ResizeGrip" Grid.Row="0" Grid.RowSpan="5"
                        HorizontalAlignment="Left" VerticalAlignment="Top"
                        Width="26" Height="26" Margin="-33,-23,0,0"
                        Background="Transparent" Cursor="SizeNWSE">
                    <Path Stroke="{StaticResource ButtonBorder}" StrokeThickness="2"
                          Data="M 4,20 L 20,4 M 4,13 L 13,4 M 4,6 L 6,4"/>
                </Border>
            </Grid>
        </ls:LSNineSliceImage>

        <Grid Canvas.Left="{Binding PanelX}" Canvas.Top="{Binding TabsY}" Width="{Binding PanelW}"
              Opacity="{Binding PanelOpacity}" Visibility="{Binding RootVisibility}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Top">
                <ls:LSButton Content="{Binding ChatTabLabel}" Command="{Binding TabChatCommand}">
                    <ls:LSButton.Style>
                        <Style TargetType="ls:LSButton" BasedOn="{StaticResource ChatTab}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ActiveTab}" Value="chat">
                                    <Setter Property="Template" Value="{StaticResource NC.TabButton_Active}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ls:LSButton.Style>
                </ls:LSButton>
                <Image Style="{StaticResource TabDividerImageStyle}"/>
                <ls:LSButton Content="{Binding LogTabLabel}" Command="{Binding TabLogCommand}">
                    <ls:LSButton.Style>
                        <Style TargetType="ls:LSButton" BasedOn="{StaticResource ChatTab}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ActiveTab}" Value="log">
                                    <Setter Property="Template" Value="{StaticResource NC.TabButton_Active}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ls:LSButton.Style>
                </ls:LSButton>
                <Image Style="{StaticResource TabDividerImageStyle}"/>
                <ls:LSButton Content="{Binding DiceLabel}" Command="{Binding DiceCommand}">
                    <ls:LSButton.Style>
                        <Style TargetType="ls:LSButton" BasedOn="{StaticResource ChatTab}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding DiceOpen}" Value="on">
                                    <Setter Property="Tag" Value="open"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ls:LSButton.Style>
                </ls:LSButton>
            </StackPanel>
        </Grid>

        <Grid x:Name="SideBar" Canvas.Left="{Binding SideX}" Canvas.Top="{Binding SideY}" Width="{Binding SideW}"
              Opacity="{Binding PanelOpacity}" Visibility="{Binding RootVisibility}">
            <Border x:Name="SettingsBar" HorizontalAlignment="Center" Background="{StaticResource BarBg}" BorderBrush="{StaticResource ButtonBorder}"
                    BorderThickness="2" CornerRadius="34" Padding="10,0">
                <StackPanel Orientation="Horizontal">

                    <ls:LSButton Style="{StaticResource HudToggle}" Command="{Binding KeyCommand}">
                        <ls:LSButton.ToolTip><ls:LSTooltip Placement="Top" Content="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}" ContentTemplate="{StaticResource TipKeyTemplate}"/></ls:LSButton.ToolTip>
                        <Grid Width="32" Height="32">
                            <Path Visibility="{Binding KeyIconVisibility}" Stroke="{StaticResource Gold}" StrokeThickness="2.5" Fill="Transparent"
                                  Data="M 3,16 A 6,6 0 1 1 15,16 A 6,6 0 1 1 3,16 Z M 15,16 L 30,16 M 25,16 L 25,22 M 30,16 L 30,21"/>
                            <TextBlock Visibility="{Binding KeyWaitVisibility}" Text="..." Foreground="{StaticResource Gold}" FontSize="28"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                    </ls:LSButton>
                    <ls:LSButton Style="{StaticResource HudToggle}" Tag="{Binding OverheadState}" Command="{Binding OverheadCommand}">
                        <ls:LSButton.ToolTip><ls:LSTooltip Placement="Top" Content="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}" ContentTemplate="{StaticResource TipOverheadTemplate}"/></ls:LSButton.ToolTip>
                        <Path Stroke="{StaticResource Gold}" StrokeThickness="2.5" Fill="Transparent"
                              Data="M 4,6 L 28,6 L 28,22 L 14,22 L 8,28 L 9,22 L 4,22 Z"/>
                    </ls:LSButton>
                    <ls:LSButton Style="{StaticResource HudToggle}" Tag="{Binding AutoHideState}" Command="{Binding AutoHideCommand}">
                        <ls:LSButton.ToolTip><ls:LSTooltip Placement="Top" Content="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}" ContentTemplate="{StaticResource TipAutoHideTemplate}"/></ls:LSButton.ToolTip>
                        <Grid Width="32" Height="32">
                            <Path Stroke="{StaticResource Gold}" StrokeThickness="2.5" Fill="Transparent"
                                  Data="M 2,16 Q 16,2 30,16 Q 16,30 2,16 Z"/>
                            <Ellipse Width="9" Height="9" Fill="{StaticResource Gold}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                    </ls:LSButton>
                    <Image Style="{StaticResource TabDividerImageStyle}" Margin="-16,0"/>
                    <ls:LSButton Template="{StaticResource MinButton}" Command="{Binding FontDownCommand}" Focusable="False" VerticalAlignment="Center"><ls:LSButton.ToolTip><ls:LSTooltip Placement="Top" Content="{Binding PlacementTarget.DataContext.TipFontDown, RelativeSource={RelativeSource Self}}" ContentTemplate="{StaticResource TipPlainTemplate}"/></ls:LSButton.ToolTip></ls:LSButton>
                    <TextBlock Text="{Binding FontLabel}" Style="{StaticResource BarValue}"/>
                    <ls:LSButton Template="{StaticResource PlusButton}" Command="{Binding FontUpCommand}" Focusable="False" VerticalAlignment="Center"><ls:LSButton.ToolTip><ls:LSTooltip Placement="Top" Content="{Binding PlacementTarget.DataContext.TipFontUp, RelativeSource={RelativeSource Self}}" ContentTemplate="{StaticResource TipPlainTemplate}"/></ls:LSButton.ToolTip></ls:LSButton>
                    <Image Style="{StaticResource TabDividerImageStyle}" Margin="-16,0"/>
                    <ls:LSButton Template="{StaticResource MinButton}" Command="{Binding ActiveDownCommand}" Focusable="False" VerticalAlignment="Center"><ls:LSButton.ToolTip><ls:LSTooltip Placement="Top" Content="{Binding PlacementTarget.DataContext.TipActiveDown, RelativeSource={RelativeSource Self}}" ContentTemplate="{StaticResource TipPlainTemplate}"/></ls:LSButton.ToolTip></ls:LSButton>
                    <TextBlock Text="{Binding ActiveLabel}" Style="{StaticResource BarValue}"/>
                    <ls:LSButton Template="{StaticResource PlusButton}" Command="{Binding ActiveUpCommand}" Focusable="False" VerticalAlignment="Center"><ls:LSButton.ToolTip><ls:LSTooltip Placement="Top" Content="{Binding PlacementTarget.DataContext.TipActiveUp, RelativeSource={RelativeSource Self}}" ContentTemplate="{StaticResource TipPlainTemplate}"/></ls:LSButton.ToolTip></ls:LSButton>
                    <Image Style="{StaticResource TabDividerImageStyle}" Margin="-16,0"/>
                    <ls:LSButton Template="{StaticResource MinButton}" Command="{Binding IdleDownCommand}" Focusable="False" VerticalAlignment="Center"><ls:LSButton.ToolTip><ls:LSTooltip Placement="Top" Content="{Binding PlacementTarget.DataContext.TipIdleDown, RelativeSource={RelativeSource Self}}" ContentTemplate="{StaticResource TipPlainTemplate}"/></ls:LSButton.ToolTip></ls:LSButton>
                    <TextBlock Text="{Binding IdleLabel}" Style="{StaticResource BarValue}"/>
                    <ls:LSButton Template="{StaticResource PlusButton}" Command="{Binding IdleUpCommand}" Focusable="False" VerticalAlignment="Center"><ls:LSButton.ToolTip><ls:LSTooltip Placement="Top" Content="{Binding PlacementTarget.DataContext.TipIdleUp, RelativeSource={RelativeSource Self}}" ContentTemplate="{StaticResource TipPlainTemplate}"/></ls:LSButton.ToolTip></ls:LSButton>
                </StackPanel>
            </Border>
        </Grid>

        <ls:LSNineSliceImage x:Name="DicePanel" Panel.ZIndex="-1"
                             Canvas.Left="{Binding DiceX}" Canvas.Top="{Binding DiceY}"
                             Width="{Binding DiceW}" Height="{Binding DiceH}"
                             Opacity="{Binding PanelOpacity}"
                             Visibility="{Binding DiceVisibility, FallbackValue=Collapsed}"
                             ImageSource="{StaticResource PanelBg}"
                             Slices="52"
                             Padding="28,28,28,28">
            <Grid>
                <ls:LSScrollViewer Template="{StaticResource NC.ScrollViewer}" Focusable="False"
                                   HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,0,0,6">
                        <UniformGrid Columns="3">
                            <ls:LSButton Style="{StaticResource PillButton}" FontSize="28" Margin="2" Tag="{Binding DiceActiveState}" Content="{Binding DiceActiveLabel}" Command="{Binding DiceActiveCommand}"/>
                            <ls:LSButton Style="{StaticResource PillButton}" FontSize="28" Margin="2" Tag="{Binding DicePassiveState}" Content="{Binding DicePassiveLabel}" Command="{Binding DicePassiveCommand}"/>
                            <ls:LSButton Style="{StaticResource PillButton}" FontSize="28" Margin="2" Tag="{Binding DiceAdvState}" Content="{Binding DiceAdvLabel}" Command="{Binding DiceAdvCommand}"/>
                        </UniformGrid>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
                            <ls:LSButton Template="{StaticResource MinButton}" Command="{Binding DiceDcPrevCommand}" Focusable="False" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding DiceDcValue}" Foreground="{StaticResource Text}" FontSize="30" MinWidth="320" TextAlignment="Center"
                                       VerticalAlignment="Center" Margin="10,0"/>
                            <ls:LSButton Template="{StaticResource PlusButton}" Command="{Binding DiceDcNextCommand}" Focusable="False" VerticalAlignment="Center"/>
                        </StackPanel>

                        <ContentControl Template="{StaticResource GoldSeparator}" Margin="0,18,0,10"/>
                        <ItemsControl ItemsSource="{Binding Abilities}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><UniformGrid Columns="6"/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <ls:LSButton Style="{StaticResource AbilityHexButton}" Height="104" Margin="1,4" Command="{Binding RollCommand}">
                                        <Viewbox StretchDirection="DownOnly" MaxWidth="76" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Label}" FontSize="28" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                        </Viewbox>
                                    </ls:LSButton>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Border Height="10"/>
                        <ItemsControl ItemsSource="{Binding Skills}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><UniformGrid Columns="2"/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <ls:LSButton Style="{StaticResource ChoiceButton}" FontSize="28" MinHeight="56" Content="{Binding Label}" Command="{Binding RollCommand}"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ls:LSScrollViewer>
            </Grid>
        </ls:LSNineSliceImage>

        <Border x:Name="DragOverlay" Canvas.Left="-4000" Canvas.Top="-4000" Width="12000" Height="10000"
                Background="#01000000" Visibility="{Binding DragOverlayVisibility, FallbackValue=Collapsed}"/>
    </Canvas>
</ls:UIWidget>
